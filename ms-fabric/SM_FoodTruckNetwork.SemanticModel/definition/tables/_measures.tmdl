			```
		formatString: #,0
		displayFolder: 01_total_orders
		lineageTag: 8a6e00d8-dac7-45f3-a63f-b5579ed57bd3

	measure 'MoM % Change - Total Orders' =
			
			
			VAR LastMonthOrders = [Last Month - Total Orders]
			VAR PreviousMonthOrders = [Previous Month - Total Orders]
			
			VAR MoMPercentageChange =
			IF(
			    PreviousMonthOrders > 0,
			    (LastMonthOrders - PreviousMonthOrders) / PreviousMonthOrders,
			    BLANK()
			)
			
			RETURN MoMPercentageChange
		displayFolder: 01_total_orders
		lineageTag: 0b957931-21ec-4e1a-abad-6d402587708e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

