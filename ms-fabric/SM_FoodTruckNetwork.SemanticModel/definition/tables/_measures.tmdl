	measure 'Text - Year Period View' = ```
			
			
			VAR LatestVisiblePeriod = 
			CALCULATE(
			    MAX(dim_order_date[Month Year]), 
			    ALLSELECTED(dim_order_date)
			)
			
			VAR EarliestVisiblePeriod = 
			CALCULATE(
			    MIN(dim_order_date[Month Year]), 
			    ALLSELECTED(dim_order_date)
			)
			
			VAR LatestPeriodStart =
			CALCULATE(
			    MIN(dim_order_date[Order Date]), 
			    dim_order_date[Month Year] = LatestVisiblePeriod
			)
			
			VAR LatestYearStart = DATE(YEAR(LatestPeriodStart), 1, 1)
			VAR LatestYearEnd = EOMONTH(LatestPeriodStart, 0)
			
			VAR TextYearPeriod =
			"Period View: " &
			IF(
			    YEAR(LatestVisiblePeriod) - YEAR(EarliestVisiblePeriod) > 1,
			    "All",
			    FORMAT(LatestYearStart, "mmmm YYYY") & " - " & FORMAT(LatestYearEnd, "mmmm YYYY")
			)
			
			RETURN TextYearPeriod
			```
		lineageTag: 2cb7620c-2936-4ac9-912b-471ba9725f51

	measure 'Text - Previous Year Period' = ```
			
			
			VAR LatestVisiblePeriod =
			CALCULATE(
			    MAX(dim_order_date[Month Year]),
			    ALLSELECTED(dim_order_date)
			)
			
			VAR LatestPeriodStart =
			CALCULATE(
			    MIN(dim_order_date[Order Date]),
			    ALLSELECTED(dim_order_date),
			    dim_order_date[Month Year] = LatestVisiblePeriod
			)
			
			VAR StartYearLatestPeriod = DATE(YEAR(LatestPeriodStart), 1, 1)
			VAR PreviousYearStart = EOMONTH(StartYearLatestPeriod, -13) + 1
			VAR PreviousYearEnd = EOMONTH(StartYearLatestPeriod, -1)
			
			VAR TextPreviousYear = 
			"vs (" & 
			FORMAT(PreviousYearStart, "mmm YY") & 
			" - " & 
			FORMAT(PreviousYearEnd, "mmm YY") & ")"
			
			RETURN TextPreviousYear
			```
		lineageTag: 1ed3fa30-1da4-4724-9716-07365be48f99

