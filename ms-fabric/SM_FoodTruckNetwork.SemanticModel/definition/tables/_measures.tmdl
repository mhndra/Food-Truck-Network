	measure 'Text - Month Period View' = ```
			
			
			VAR LatestVisiblePeriod = 
			CALCULATE(
			    MAX(dim_order_date[Month Year]),
			    ALLSELECTED(dim_order_date)
			)
			
			VAR EarliestVisiblePeriod = 
			CALCULATE(
			    MIN(dim_order_date[Month Year]),
			    ALLSELECTED(dim_order_date)
			)
			
			VAR LatestMonthStart =
			CALCULATE(
			    MIN(dim_order_date[Order Date]), 
			    dim_order_date[Month Year] = LatestVisiblePeriod
			)
			
			VAR TextMonthPeriod =
			"Period View: " &
			IF(
			    LatestVisiblePeriod <> EarliestVisiblePeriod,
			    "All",
			    FORMAT(LatestMonthStart, "mmmm YYYY")
			)
			
			RETURN TextMonthPeriod
			```
		lineageTag: b1e85ad0-b763-4cbd-806d-7ad3c9a32e5e

	measure 'Text - Previous Month Period' =
			
			
			VAR LatestVisiblePeriod =
			CALCULATE(
			    MAX(dim_order_date[Month Year]),
			    ALLSELECTED(dim_order_date)
			)
			
			VAR LatestPeriodStart =
			CALCULATE(
			    MIN(dim_order_date[Order Date]),
			    ALLSELECTED(dim_order_date),
			    dim_order_date[Month Year] = LatestVisiblePeriod
			)
			
			VAR PreviousMonthPeriod = EOMONTH(LatestPeriodStart, -2) + 1
			
			VAR TextPreviousMonth = "vs " & FORMAT(PreviousMonthPeriod, "mmmm YYYY")
			
			RETURN TextPreviousMonth
		lineageTag: e10e6cfb-845e-4118-a616-4d20ab4b605a

	measure 'Last Year - Total Orders' = ```
			
			
