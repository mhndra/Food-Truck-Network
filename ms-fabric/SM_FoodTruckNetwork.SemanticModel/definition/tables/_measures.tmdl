table _measures
	lineageTag: 0b941c4b-ddb5-415b-a5b2-bccfe979a953

	measure 'Total Orders' = DISTINCTCOUNT(fact_order_headers[Order ID])
		formatString: #,0
		displayFolder: 01_total_orders
		lineageTag: dd9fa517-aa9a-4a5f-aa3c-8f5448511eef

	measure 'Total Sales' = SUM(fact_order_headers[Total Order Price (USD)] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 03_total_sales
		lineageTag: db0c270c-e190-4121-a709-3c3825e7e2bd

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Quantities' = SUM(fact_order_headers[Total Order Quantities])
		formatString: #,0
		displayFolder: 02_total_quantities
		lineageTag: 2713bf91-d851-4b73-94d0-43e44f6fadd4

	measure 'Ranked City Sales' =
			
			VAR _SelectedValue = SELECTEDVALUE(_top_bottom_city[Column1])
			RETURN
			IF(
			    _SelectedValue = "Top",
			    RANKX(ALLSELECTED(dim_locations[City]), [Total Sales],, DESC, Dense),
			    RANKX(ALLSELECTED(dim_locations[City]), [Total Sales],, ASC, Dense)
			)
		formatString: 0
		lineageTag: 9d167114-ab2c-4329-bf56-4e6f268b10e2

	measure 'Selected City Sales' =
			
			VAR _SelectedValue = SELECTEDVALUE(_city_rank_range[_city_rank_range])
			RETURN
			IF(
			    ISBLANK(_SelectedValue),
			    [Total Sales],
			    IF([Ranked City Sales] <= _SelectedValue, [Total Sales], BLANK())
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f21b055a-47a1-44f2-ae96-e6b4930406f1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Max Location Insights' =
			
			
			VAR SelectedLocation = SELECTEDVALUE(_location_parameters[_location_parameters Order])
			VAR SelectedInsight = SELECTEDVALUE(_insight_parameters[_insight_parameters Order])
			
			VAR MaxOrders = SWITCH(
			    SelectedLocation,
			    0, CALCULATE(MAXX(ALL(dim_locations[City]), [Total Orders]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_locations[Location]), [Total Orders]), ALLSELECTED(fact_order_headers))
			)
			
			VAR MaxQuantities = SWITCH(
			    SelectedLocation,
			    0, CALCULATE(MAXX(ALL(dim_locations[City]), [Total Quantities]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_locations[Location]), [Total Quantities]), ALLSELECTED(fact_order_headers))
			)
			
			VAR MaxSales = SWITCH(
			    SelectedLocation,
			    0, CALCULATE(MAXX(ALL(dim_locations[City]), [Total Sales]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_locations[Location]), [Total Sales]), ALLSELECTED(fact_order_headers))
			)
			
			VAR Color = SWITCH(
			    TRUE(),
			    SelectedInsight = 0 && [Total Orders] = MaxOrders, "#118DFF",
			    SelectedInsight = 1 && [Total Quantities] = MaxQuantities, "#118DFF",
			    SelectedInsight = 2 && [Total Sales] = MaxSales, "#118DFF",
			    "#E6E6E6"
			)
			
			RETURN Color
		displayFolder: 00_insights
		lineageTag: 0c8e3ac0-0dc8-45fb-8a46-52be837d169d

	measure 'Max Truck Insights' =
			
			
			VAR SelectedTruck = SELECTEDVALUE(_truck_parameters[_truck_parameters Order])
			VAR SelectedInsight = SELECTEDVALUE(_insight_parameters[_insight_parameters Order])
			
			VAR MaxOrders = SWITCH(
			    SelectedTruck,
			    0, CALCULATE(MAXX(ALL(dim_trucks[Truck Brand Name]), [Total Orders]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_trucks[Model]), [Total Orders]), ALLSELECTED(fact_order_headers))
			)
			
			VAR MaxQuantities = SWITCH(
			    SelectedTruck,
			    0, CALCULATE(MAXX(ALL(dim_trucks[Truck Brand Name]), [Total Quantities]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_trucks[Model]), [Total Quantities]), ALLSELECTED(fact_order_headers))
			)
			
			VAR MaxSales = SWITCH(
			    SelectedTruck,
			    0, CALCULATE(MAXX(ALL(dim_trucks[Truck Brand Name]), [Total Sales]), ALLSELECTED(fact_order_headers)),
			    1, CALCULATE(MAXX(ALL(dim_trucks[Model]), [Total Sales]), ALLSELECTED(fact_order_headers))
			)
			
			VAR Color = SWITCH(
			    TRUE(),
			    SelectedInsight = 0 && [Total Orders] = MaxOrders, "#118DFF",
			    SelectedInsight = 1 && [Total Quantities] = MaxQuantities, "#118DFF",
			    SelectedInsight = 2 && [Total Sales] = MaxSales, "#118DFF",
			    "#E6E6E6"
			)
			
			RETURN Color
		displayFolder: 00_insights
		lineageTag: 9d9a0de2-8e8e-4967-b78f-057ebf3e80a4

	measure 'Last Month - Total Orders' = ```
			
			
			VAR LatestVisiblePeriod = 
			CALCULATE(
			    MAX(dim_order_date[Month Year]), 
			    ALLSELECTED(dim_order_date)
			)
			
			VAR LatestPeriodStart =
			CALCULATE(
			    MIN(dim_order_date[Order Date]), 
			    ALLSELECTED(dim_order_date),
			    dim_order_date[Month Year] = LatestVisiblePeriod
			)
			
			VAR LastMonthOrders =
			CALCULATE(
			    [Total Orders],
			    REMOVEFILTERS(dim_order_date),
			    DATESBETWEEN(
			        dim_order_date[Order Date],
			        EOMONTH(LatestPeriodStart, -1) + 1,
			        EOMONTH(LatestPeriodStart, 0)
			    )
			)
			
			RETURN LastMonthOrders
			```
		formatString: #,0
		displayFolder: 01_total_orders
		lineageTag: 6485db1d-3d52-49f7-80e0-13891d688564

	measure 'Previous Month - Total Orders' = ```
			
			
