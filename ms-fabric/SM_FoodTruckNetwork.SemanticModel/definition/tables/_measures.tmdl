	measure 'YoY % Change - Total Orders' =
			
			
			VAR LastYearOrders = [Last Year - Total Orders]
			VAR PreviousYearOrders = [Previous Year - Total Orders]
			
			VAR YoYPercentageChange =
			IF(
			    PreviousYearOrders > 0,
			    (LastYearOrders - PreviousYearOrders) / PreviousYearOrders,
			    BLANK()
			)
			
			RETURN YoYPercentageChange
		displayFolder: 01_total_orders
		lineageTag: d3227647-966a-48d9-aa1b-c9e50f6ba84b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

