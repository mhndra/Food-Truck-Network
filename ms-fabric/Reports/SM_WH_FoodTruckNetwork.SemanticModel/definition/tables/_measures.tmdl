	measure 'Performance Score WoW %' = [Total Orders WoW %] * 0.4 + [Total Sales WoW %] * 0.4 + [AOV WoW %] * 2
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: 07_performance
		lineageTag: 5fa7347f-8956-48af-9ce8-5df405e64811

	measure 'Tooltip - Declining Performance' = ```
			
			
			VAR SummaryTable =
			ADDCOLUMNS(
			    VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			    "@Score", [Performance Score WoW %],
			    "@Basket", [Basket WoW %],
			    "@Price", [Price WoW %]
			)
			
			VAR Worst = TOPN(1, SummaryTable, [@Score], ASC)
			VAR WorstName = MAXX(Worst, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			VAR WorstScore = MAXX(Worst, [@Score])
			
			VAR Driver =
			IF(
			    MAXX(Worst, [@Basket]) < MAXX(Worst, [@Price]),
			    "a drop in items sold per order (basket size)",
			    "a drop in sales per item sold (average price per item)"
			)
			
			VAR TooltipDecliningPerformance =
			"⚠️ " & WorstName & 
			" declined the most this last week (score " & FORMAT(WorstScore,"+0.00%;-0.00%") &
			"), mainly driven by " & Driver & "."
			
			RETURN TooltipDecliningPerformance
			```
		displayFolder: 07_performance
		lineageTag: eec803c9-c591-4b95-8c83-6457bcf2434e

	measure '📉 Declining Performance' =
			
			
			VAR SummaryTable =
			ADDCOLUMNS(
			    VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			    "@Score", [Performance Score WoW %],
			    "@Orders", [Total Orders WoW %],
			    "@Basket", [Basket WoW %],
			    "@Price", [Price WoW %]
			)
			
			VAR Worst = TOPN(1, SummaryTable, [@Score], ASC)
			VAR WorstName = MAXX(Worst, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			
			VAR TextDecliningPerformance = WorstName & " declined the most this last week"
			
			RETURN TextDecliningPerformance
		displayFolder: 07_performance
		lineageTag: ebcd7d4d-d27e-4501-97ad-c67d7e1da660

	measure '📈 Rising Performance' =
			
			VAR SummaryTable =
			ADDCOLUMNS(
			    VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			    "@Score", [Performance Score WoW %],
			    "@Orders", [Total Orders WoW %],
			    "@Basket", [Basket WoW %],
			    "@Price", [Price WoW %]
			)
			
			VAR Best = TOPN(1, SummaryTable, [@Score], DESC)
			VAR BestName = MAXX(Best, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			
			VAR TextRisingPerformance = BestName & " posted the highest performance gain this last week"
			
			RETURN TextRisingPerformance
		displayFolder: 07_performance
		lineageTag: f6051270-ff5e-4d2a-8c6e-7d7066d848fb

	measure 'Tooltip - Rising Performance' = ```
			
			VAR SummaryTable =
			    ADDCOLUMNS(
			        VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			        "@Score", [Performance Score WoW %],
			        "@Basket", [Basket WoW %],
			        "@Price", [Price WoW %]
			    )
			
			VAR Best = TOPN(1, SummaryTable, [@Score], DESC)
			VAR BestName = MAXX(Best, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			VAR BestScore = MAXX(Best, [@Score])
			
			VAR Driver = 
			IF(
			    MAXX(Best, [@Basket]) > MAXX(Best, [@Price]), 
			    "more items sold per order (successful cross-sell)", 
			    "higher average price per item (successful upsell/menu-mix)"
			)
			
			VAR TooltipRisingPerformance =
			"📈 " & BestName & 
			" posted the highest performance gain this last week (score " & 
			FORMAT(BestScore,"+0.00%;-0.00%") &
			"), driven mainly by " & Driver & ". Worth replicating as best practice."
			
			RETURN TooltipRisingPerformance
			```
		displayFolder: 07_performance
		lineageTag: 116d6608-3847-454b-9731-db3a72b2f423

	measure 'Tooltip - Opportunity Improvement' = ```
			
			
			VAR OverallBasket = [Basket Size (Basket)]
			VAR OverallPrice = [Avg Price per Item (Price)]
			VAR OverallAOV = [Avg Order Value (AOV)]
			
			VAR SummaryTable =
			ADDCOLUMNS(
			    VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			    "@AOV", [Avg Order Value (AOV)],
			    "@Orders", [Total Orders Last Week],
			    "@Basket", [Basket Size (Basket)],
			    "@Price", [Avg Price per Item (Price)]
			)
			
			VAR WithGap =
			ADDCOLUMNS(
			    SummaryTable,
			    "@Uplift", (OverallAOV - [@AOV]) * [@Orders],
			    "@BasketGap", DIVIDE(OverallBasket - [@Basket], OverallBasket),
			    "@PriceGap", DIVIDE(OverallPrice - [@Price], OverallPrice)
			)
			
			VAR BestOpp = TOPN(1, FILTER(WithGap, [@Uplift] > 0), [@Uplift], DESC)
			VAR OppName = MAXX(BestOpp, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			VAR OppUplift = MAXX(BestOpp, [@Uplift])
			
			VAR Driver = 
			IF(
			    MAXX(BestOpp, [@BasketGap]) > MAXX(BestOpp, [@PriceGap]),
			    "cross-sell — increase items per order through bundling or combo deals",
			    "upsell/menu-mix — steer customers toward higher-priced items"
			)
			
			VAR TooltipOppImprovement =
			"💡 " & OppName & 
			" has an estimated upside of ~$" & FORMAT(OppUplift,"#,##0") &
			" in sales if AOV is raised to the system average. The most relevant strategy: " & Driver & "."
			
			RETURN TooltipOppImprovement
			```
		displayFolder: 07_performance
		lineageTag: 88e5c292-b990-459a-a3e5-8cd7a82a5e99

	measure '💡 Opportunity Improvement' =
			
			
			VAR OverallBasket = [Basket Size (Basket)]
			VAR OverallPrice = [Avg Price per Item (Price)]
			VAR OverallAOV = [Avg Order Value (AOV)]
			
			VAR SummaryTable =
			ADDCOLUMNS(
			    VALUES(dim_franchise_owners_snapshot[Franchise Owner Full Name]),
			    "@AOV", [Avg Order Value (AOV)],
			    "@Orders", [Total Orders],
			    "@Basket", [Basket Size (Basket)],
			    "@Price", [Avg Price per Item (Price)]
			)
			
			VAR WithGap =
			ADDCOLUMNS(
			    SummaryTable,
			    "@Uplift", (OverallAOV - [@AOV]) * [@Orders],
			    "@BasketGap", DIVIDE(OverallBasket - [@Basket], OverallBasket),
			    "@PriceGap", DIVIDE(OverallPrice - [@Price], OverallPrice)
			)
			
			VAR BestOpp = TOPN(1, FILTER(WithGap, [@Uplift] > 0), [@Uplift], DESC)
			VAR OppName = MAXX(BestOpp, dim_franchise_owners_snapshot[Franchise Owner Full Name])
			VAR OppUplift = MAXX(BestOpp, [@Uplift])
			
			VAR TextOppImprovement = OppName & " has an estimated upside of ~$" & FORMAT(OppUplift,"#,##0")
			
			RETURN TextOppImprovement
		displayFolder: 07_performance
		lineageTag: 01d49c2d-b951-4f5d-beb8-df4dcb03f9a0

