table _measures
	lineageTag: 0e8feabe-3076-4192-a3d6-dda9c4fbd7c6

	measure 'Total Orders' = DISTINCTCOUNT(fact_order_details[Order ID])
		formatString: 0
		displayFolder: 01_total_orders
		lineageTag: c778d4e2-34bb-4cc2-9a3b-5930b75385bb

	measure 'Total Orders Last Week' =
			
			
			VAR LatestWeeklyPeriod = MAX(dim_order_date[First Day of Week (ISO)])
			
			VAR OrdersLastWeek =
			CALCULATE(
			    [Total Orders],
			    REMOVEFILTERS(dim_order_date),
			    DATESBETWEEN(
			        dim_order_date[Order Date],
			        LatestWeeklyPeriod,
			        LatestWeeklyPeriod + 6
			    )
			)
			
			RETURN OrdersLastWeek
		formatString: 0
		displayFolder: 01_total_orders
		lineageTag: 35d05ee1-ba9b-41dd-8cfd-2861e1d97d5c

	measure 'Total Orders Previous Week' =
			
			
			VAR LatestWeeklyPeriod = MAX(dim_order_date[First Day of Week (ISO)])
			
			VAR OrdersPreviousWeek =
			CALCULATE(
			    [Total Orders],
			    REMOVEFILTERS(dim_order_date),
			    DATESBETWEEN(
			        dim_order_date[Order Date],
			        LatestWeeklyPeriod - 7,
			        LatestWeeklyPeriod - 1
			    )
			)
			
			RETURN OrdersPreviousWeek
		formatString: 0
		displayFolder: 01_total_orders
		lineageTag: e6de319b-1b6c-4895-9fad-12eebe809254

	measure 'Total Orders WoW %' =
			
			
			VAR OrdersLastWeek = [Total Orders Last Week]
			VAR OrdersPreviousWeek = [Total Orders Previous Week]
			
			VAR OrdersWoW =
			IF(
			    OrdersPreviousWeek > 0,
			    (OrdersLastWeek - OrdersPreviousWeek) / OrdersPreviousWeek,
			    BLANK()
			)
			
			RETURN OrdersWoW
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01_total_orders
		lineageTag: 116bef0a-40d9-4d2f-a513-fe602a5efbe2

	measure 'Text - Total Orders WoW %' = FORMAT([Total Orders WoW %], "+0.00% ▲;-0.00% ▼")
		displayFolder: 01_total_orders
		lineageTag: a5e6b868-1b88-4a74-bf52-1638e1b203b3

	measure 'Text - Weekly Period View' =
			
			
			VAR LatestWeeklyPeriod = MAX(dim_order_date[First Day of Week (ISO)])
			
			VAR LatestPeriodDate =
			CALCULATE(
			    MAX(dim_order_date[Order Date]),
			    REMOVEFILTERS(dim_order_date),
			    dim_order_date[First Day of Week (ISO)] = LatestWeeklyPeriod
			)
			
			VAR EarliestPeriodDate =
			CALCULATE(
			    MIN(dim_order_date[Order Date]),
			    REMOVEFILTERS(dim_order_date),
			    dim_order_date[First Day of Week (ISO)] = LatestWeeklyPeriod
			)
			
			VAR TextWeeklyPeriod =
			"Weekly Period View: " &
			FORMAT(EarliestPeriodDate, "dd/mmm/yyyy") & " - " & FORMAT(LatestPeriodDate, "dd/mmm/yyyy")
			
			RETURN TextWeeklyPeriod
		displayFolder: 00_miscellaneous
		lineageTag: 18ebb155-8b50-463c-9ba1-bc274930f356

	measure 'Text - Franchise City' = ```
			
			
			VAR FranchiseCity = SELECTEDVALUE(dim_franchise_owners_snapshot[Franchise City Grouped])
			
			VAR TextFranchiseCity =
			SUBSTITUTE(
			    SUBSTITUTE(FranchiseCity, "[""", ""), 
			    """]", 
			    ""
			)
			
			RETURN TextFranchiseCity
			```
		displayFolder: 00_miscellaneous
		lineageTag: d5f5133c-199c-4700-9181-f6436a48c2c7

	measure Slicer = INT(NOT ISEMPTY(fact_order_details))
		formatString: 0
		displayFolder: 00_miscellaneous
		lineageTag: 643fa835-6ef0-43ab-8ee0-71deeca2bc98

	measure 'Label - Previous Week Period' = ```
			
			
			VAR LatestWeeklyPeriod = MAX(dim_order_date[First Day of Week (ISO)])
			
			VAR LabelPreviousWeek = 
			"vs (" &
			FORMAT(LatestWeeklyPeriod - 7, "dd/mmm/yyyy") & 
			" - " & 
			FORMAT(LatestWeeklyPeriod - 1, "dd/mmm/yyyy") &
			")"
			
			RETURN LabelPreviousWeek
			```
		displayFolder: 00_miscellaneous
		lineageTag: 2fd6a17a-ae91-4faa-91e8-680c752622f1

