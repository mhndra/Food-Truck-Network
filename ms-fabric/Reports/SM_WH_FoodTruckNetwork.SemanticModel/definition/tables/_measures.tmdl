	measure 'Avg Order Value (AOV)' = ```
			DIVIDE([Total Sales], [Total Orders]) 
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04_sales_per_orders
		lineageTag: 23006765-470f-42a2-89ba-1ef699825a97

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'AOV Last Week' =
			
			
			VAR SalesLastWeek = [Total Sales Last Week]
			VAR OrdersLastWeek = [Total Orders Last Week]
			
			VAR AOVLastWeek = DIVIDE(SalesLastWeek, OrdersLastWeek)
			
			RETURN AOVLastWeek
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 04_sales_per_orders
